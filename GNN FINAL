    "        batch_size=batch_size,\n",
    "        shuffle=shuffle,\n",
    "        follow_batch=[\"x_wt\", \"x_mut\"],\n",
    "        exclude_keys=[\"protein\", \"protein_group\", \"mutation\", \"graph_source\", \"chain_id\"],\n",
    "    )\n",
