    "def build_edges_from_coords(coords, original_indices, cutoff=CONTACT_CUTOFF):\n",
    "    coords = np.asarray(coords, dtype=np.float32)\n",
    "    original_indices = np.asarray(original_indices)\n",
    "    n = len(coords)\n",
    "    src, dst, attrs = [], [], []\n",
